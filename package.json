{
  "name": "herway",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"{apps,packages}/**/*.{ts,tsx,json}\" \"*.{json,yml,yaml,md}\"",
    "dev:api": "pnpm --filter @herway/api dev",
    "dev:mobile": "pnpm --filter @herway/mobile start"
  },
  "devDependencies": {
    "turbo": "^2.5.8",
    "typescript-eslint": "^8.46.4",
    "prettier": "^3.6.2",
    "pnpm": "12.21.0"
  }
}
