rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Check if the current user is a verified driver
    function isDriver() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isDriver == true;
    }

    // --- Rules ---

    // User profiles: Only the user can read/write their own profile
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.isDriver == false
        && request.resource.data.isVerified == false;
      allow update: if isOwner(userId)
        && request.resource.data.isDriver == resource.data.isDriver
        && request.resource.data.isVerified == resource.data.isVerified;
    }

    // Rides: 
    // 1. Riders can create rides and read their own rides.
    // 2. Drivers can read 'requested' rides and update them when accepting.
    // 3. Both can update/read a ride they are part of.
    match /rides/{rideId} {
      
      // Only authenticated users can create a ride for themselves
      allow create: if isAuthenticated() && 
        request.resource.data.riderId == request.auth.uid &&
        request.resource.data.status == 'requested' &&
        request.resource.data.driverId == null;
      
      // Access control for reading ride data
      allow read: if isAuthenticated() && (
        resource.data.riderId == request.auth.uid || 
        resource.data.driverId == request.auth.uid ||
        (resource.data.status == 'requested' && isDriver())
      );
      
      // Access control for updating ride state
      allow update: if isAuthenticated() && (
        // Rider can cancel before the trip starts
        (resource.data.riderId == request.auth.uid &&
          resource.data.status in ['requested', 'accepted'] &&
          request.resource.data.status == 'cancelled' &&
          request.resource.data.riderId == resource.data.riderId) ||
        
        // Driver can accept a requested ride (if they are a verified driver)
        (resource.data.status == 'requested' &&
          request.resource.data.status == 'accepted' &&
          request.resource.data.driverId == request.auth.uid &&
          isDriver()) ||
        
        // Assigned driver can update status (in_transit, completed)
        (resource.data.driverId == request.auth.uid &&
          request.resource.data.driverId == resource.data.driverId &&
          request.resource.data.status in ['in_transit', 'completed', 'cancelled'])
      );
      
      allow delete: if false; // Audit trail preservation
    }
  }
}
