rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Check if the current user is a verified driver
    function isDriver() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isDriver == true;
    }

    // --- Rules ---

    // User profiles: Only the user can read/write their own profile
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Rides: 
    // 1. Riders can create rides and read their own rides.
    // 2. Drivers can read 'requested' rides and update them when accepting.
    // 3. Both can update/read a ride they are part of.
    match /rides/{rideId} {
      
      // Only authenticated users can create a ride for themselves
      allow create: if isAuthenticated() && 
        request.resource.data.riderId == request.auth.uid &&
        request.resource.data.status == 'requested';
      
      // Access control for reading ride data
      allow read: if isAuthenticated() && (
        resource.data.riderId == request.auth.uid || 
        resource.data.driverId == request.auth.uid ||
        (resource.data.status == 'requested' && isDriver())
      );
      
      // Access control for updating ride state
      allow update: if isAuthenticated() && (
        // Rider can cancel their own requested ride
        (resource.data.riderId == request.auth.uid && request.resource.data.status == 'cancelled') ||
        
        // Driver can accept a requested ride (if they are a verified driver)
        (resource.data.status == 'requested' && request.resource.data.status == 'accepted' && isDriver()) ||
        
        // Assigned driver can update status (in_transit, completed)
        (resource.data.driverId == request.auth.uid)
      );
      
      allow delete: if false; // Audit trail preservation
    }
  }
}
