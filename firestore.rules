rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles: Only the user can read/write their own profile
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Rides: 
    // 1. Riders can create rides and read their own rides.
    // 2. Drivers can read requested rides and update them when accepting.
    // 3. Both can update a ride they are part of.
    match /rides/{rideId} {
      allow create: if isAuthenticated() && request.resource.data.riderId == request.auth.uid;
      
      allow read: if isAuthenticated() && (
        resource.data.riderId == request.auth.uid || 
        resource.data.driverId == request.auth.uid ||
        resource.data.status == 'requested'
      );
      
      allow update: if isAuthenticated() && (
        resource.data.riderId == request.auth.uid || 
        resource.data.driverId == request.auth.uid ||
        (resource.data.status == 'requested' && request.resource.data.status == 'accepted')
      );
      
      allow delete: if false; // Rides should never be deleted, only cancelled (status update)
    }
  }
}
