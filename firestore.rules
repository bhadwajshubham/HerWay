rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function hasRole(role) { return signedIn() && role in request.auth.token.roles; }

    function rideData(id) {
      return get(/databases/$(database)/documents/rideRequests/$(id)).data;
    }
    function isRideParticipant(id) {
      return signedIn() && (
        rideData(id).riderUid == request.auth.uid
        || (rideData(id).captain != null && rideData(id).captain.uid == request.auth.uid)
      );
    }
    function isVerifiedCaptain() {
      return signedIn()
        && exists(/databases/$(database)/documents/captainProfiles/$(request.auth.uid))
        && get(/databases/$(database)/documents/captainProfiles/$(request.auth.uid)).data.womenCaptain == true;
    }

    match /users/{uid} {
      allow read: if isSelf(uid);
      allow write: if false;
    }

    match /consents/{consentId} {
      allow read: if signedIn() && resource.data.firebaseUid == request.auth.uid;
      allow write: if false;
    }

    match /emergencyContacts/{contactId} {
      allow read: if signedIn() && resource.data.firebaseUid == request.auth.uid;
      allow write: if false;
    }

    match /circles/{circleId} {
      allow read: if hasRole('operator') || hasRole('admin');
      allow create, update, delete: if false;
    }

    match /circleMemberships/{membershipId} {
      allow read: if signedIn() && (resource.data.firebaseUid == request.auth.uid || hasRole('operator') || hasRole('admin'));
      allow create, update, delete: if false;
    }

    match /captainProfiles/{uid} {
      allow read: if signedIn();
      allow create, update: if isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.womenCaptain == true
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 80;
      allow delete: if false;
    }

    match /rides/{rideId} {
      allow read: if signedIn() && (resource.data.riderId == request.auth.uid || resource.data.driverId == request.auth.uid || hasRole('operator') || hasRole('admin'));
      allow create, update, delete: if false;
    }

    match /rideRequests/{rideId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.riderUid == request.auth.uid
        && request.resource.data.womenOnly == true
        && request.resource.data.status == 'SEARCHING'
        && request.resource.data.captain == null
        && request.resource.data.pickup is string
        && request.resource.data.pickup.size() >= 3
        && request.resource.data.dropoff is string
        && request.resource.data.dropoff.size() >= 3;
      allow update: if signedIn() && (
        isRideParticipant(rideId) || isVerifiedCaptain()
      ) && request.resource.data.womenOnly == true
        && request.resource.data.riderUid == resource.data.riderUid
        && request.resource.data.status in ['DRIVER_ACCEPTED', 'ARRIVED', 'IN_TRANSIT', 'COMPLETED', 'CANCELLED']
        && (
          request.resource.data.status == 'CANCELLED'
          || (resource.data.status == 'SEARCHING' && request.resource.data.status == 'DRIVER_ACCEPTED'
              && request.resource.data.captain != null
              && request.resource.data.captain.uid == request.auth.uid
              && isVerifiedCaptain())
          || (resource.data.status == 'DRIVER_ACCEPTED' && request.resource.data.status == 'ARRIVED')
          || (resource.data.status == 'ARRIVED' && request.resource.data.status == 'IN_TRANSIT')
          || (resource.data.status == 'IN_TRANSIT' && request.resource.data.status == 'COMPLETED')
        );
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isRideParticipant(rideId);
        allow create: if isRideParticipant(rideId)
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.body is string
          && request.resource.data.body.size() >= 1
          && request.resource.data.body.size() <= 500;
        allow update, delete: if false;
      }

      match /liveLocation/{locationId} {
        allow read: if isRideParticipant(rideId);
        allow write: if signedIn()
          && rideData(rideId).captain != null
          && rideData(rideId).captain.uid == request.auth.uid
          && request.resource.data.lat is number
          && request.resource.data.lng is number
          && request.resource.data.updatedAt is number;
      }
    }

    match /ridePools/{poolId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.womenOnly == true
        && request.resource.data.status == 'OPEN'
        && request.resource.data.seatsTotal >= 2
        && request.resource.data.seatsTotal <= 4
        && request.resource.data.members is list
        && request.resource.data.members.size() == 1;
      allow update: if signedIn()
        && request.resource.data.womenOnly == true
        && request.resource.data.hostUid == resource.data.hostUid
        && request.resource.data.seatsTotal == resource.data.seatsTotal
        && request.resource.data.status in ['OPEN', 'FULL', 'CLOSED', 'COMPLETED']
        && (
          (resource.data.hostUid == request.auth.uid
            && request.resource.data.status in ['CLOSED', 'COMPLETED']
            && request.resource.data.members == resource.data.members)
          || (request.resource.data.status in ['OPEN', 'FULL']
            && request.resource.data.members.size() == resource.data.members.size() + 1
            && request.resource.data.members.hasAll(resource.data.members)
            && request.resource.data.members.size() <= request.resource.data.seatsTotal)
        );
      allow delete: if false;
    }

    match /communityPosts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 2
        && request.resource.data.nickname.size() <= 32
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 3
        && request.resource.data.body.size() <= 600
        && request.resource.data.upvotes == 0;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvotes'])
        && request.resource.data.upvotes == resource.data.upvotes + 1;
      allow delete: if isSelf(resource.data.authorUid);
    }

    match /sosCases/{caseId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || hasRole('operator') || hasRole('admin'));
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /idempotency/{id} {
      allow read, write: if false;
    }
    match /audit/{id} {
      allow read, write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
