# UI demo is the safe default for mobile feedback: no Firebase, Maps, or API
# credentials are needed and no data is read or written.
HERWAY_DEMO_MODE=true

# Set HERWAY_DEMO_MODE=false before adding these for the real connected app.
# Values below are intentionally blank. Firebase and Maps browser keys are
# public client configuration, but must be restricted in their provider consoles.

FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
GOOGLE_MAPS_API_KEY=
