{
  "rules": {
    ".read": false,
    ".write": false,
    "presence": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['state','updatedAt']) && newData.child('updatedAt').isNumber()"
      }
    },
    "liveLocations": {
      ".read": false,
      ".write": false
    }
  }
}
